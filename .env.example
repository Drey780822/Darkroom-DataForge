# Darkroom DataForge Environment Configuration
# Wits–merSETA Darkroom

# Environment: development | production | testing
ENVIRONMENT=development
DEBUG=true

# API Server
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=darkroom-dataforge-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/darkroom_dataforge
# Or standard sync: postgresql://postgres:postgres@localhost:5432/darkroom_dataforge
# Default fallback: sqlite:///./storage/dataforge.db
DATABASE_URL=sqlite:///./storage/dataforge.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=50

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# OCR & AI
OCR_ENABLED=true
TESSERACT_CMD=
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
